# Partner Portal — API configuration
# Copy to `.env.local` and restart `npm run dev`.
#
# With NO env file, the app runs on the in-memory mock (USE_MOCK defaults on),
# so `npm run dev` works out of the box. Set the vars below to hit the live API.

# Flip to the real backend (any value other than "false" keeps the mock on).
NEXT_PUBLIC_USE_MOCK=false

# Base URL of the backend. Leave blank for same-origin (e.g. when the portal is
# served from the admin app). Otherwise the full origin, e.g. https://admin.bond.app
NEXT_PUBLIC_API_BASE_URL=

# The partner UUID used for the /api/partner/:id route param.
NEXT_PUBLIC_PARTNER_ID=00000000-0000-0000-0000-000000000000

# NOTE: live calls are admin-gated on the Supabase session cookie, so they only
# succeed when the app is served from an origin that carries that cookie.
