# Partner Portal — config. Copy to `.env.local` and restart `npm run dev`.
#
# The portal talks only to bond-api (auth + data). No Supabase keys in the
# frontend. With no env file it runs on the in-memory mock.

# Base URL of bond-api — the only required variable.
NEXT_PUBLIC_API_BASE_URL=https://bond-api-theta.vercel.app

# Set to "true" to run on the in-memory mock with a fake session (no backend).
NEXT_PUBLIC_USE_MOCK=false
